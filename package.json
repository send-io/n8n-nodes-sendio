{
  "name": "n8n-nodes-sendio",
  "version": "0.1.0",
  "description": "n8n community node for send.io: send transactional email, manage domains, templates and contacts, fire custom events and react to delivery webhooks",
  "license": "MIT",
  "homepage": "https://send.io",
  "keywords": [
    "n8n-community-node-package",
    "send.io",
    "sendio",
    "email",
    "transactional email"
  ],
  "author": {
    "name": "Prasad Priyadarshan",
    "email": "prasad.priyadarshan@instantly.ai"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/send-io/n8n-nodes-sendio.git"
  },
  "bugs": {
    "url": "https://github.com/send-io/n8n-nodes-sendio/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/SendIoApi.credentials.js",
      "dist/credentials/SendIoWebhookSecretApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SendIo/SendIo.node.js",
      "dist/nodes/SendIoTrigger/SendIoTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.6",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
